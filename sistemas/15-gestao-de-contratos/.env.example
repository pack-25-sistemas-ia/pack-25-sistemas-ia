# Gestão de Contratos — copie para .env.local e preencha. NUNCA versione .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...) ou anon legada. Segura para o navegador: o acesso é limitado pelo RLS e pelos privilégios das funções.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# O sistema NÃO usa service_role e não tem outros segredos de servidor. Não adicione essa chave aqui.
# O token do agendador de lembretes NÃO fica aqui: é gerado em Configurações, guardado como hash no banco e vive só no cofre do agendador (ver docs/REMINDERS.md).
