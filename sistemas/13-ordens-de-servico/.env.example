# Ordens de Serviço — copie para .env.local e preencha. NUNCA versione .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...) ou anon legada. Segura para o navegador: o acesso é limitado pelo RLS e pelos privilégios das funções.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# O sistema NÃO usa service_role: não adicione essa chave aqui.
# Sal (mín. 32 caracteres aleatórios) usado para anonimizar a origem (IP) nos limites de abuso do link de acompanhamento. SEM ele os links públicos ficam indisponíveis (falha fechada).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OS_LINK_SALT=
